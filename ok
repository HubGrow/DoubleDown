local PriceIsRight = game:GetService("Players").LocalPlayer.PlayerGui.PriceIsRight
local filePath = "price_log.txt"

function Get_Arena()
    for i,v in pairs(workspace.ArenasREAL:GetDescendants()) do
        if v:IsA("TextLabel") and v.Name == "Username" and v.Text == "@"..tostring(game.Players.LocalPlayer.Name) then
            return v.Parent.Parent.Parent.Parent.Parent
        end
    end
end

local function escapePattern(str)
    return str:gsub("([%.%-'])", "%%%1")
end

function Check_Price()
    repeat task.wait() until Get_Arena()
    local Arena = Get_Arena()
    if Arena and Arena:WaitForChild("Important") and Arena.Important:WaitForChild("GuessPrice") and Arena.Important:WaitForChild("ItemImage") then
        if Arena.Important.GuessPrice:WaitForChild("SurfaceGui") and Arena.Important.GuessPrice.SurfaceGui:WaitForChild("TextLabel") then
            if Arena.Important.ItemImage:WaitForChild("SurfaceGui") and Arena.Important.ItemImage.SurfaceGui:WaitForChild("ImageLabel") then
                local First = Arena.Important.GuessPrice.SurfaceGui.TextLabel.Text:split("$")[2]:gsub(",","")
                local Second = tostring(Arena.Important.ItemImage.SurfaceGui.ImageLabel.Image:split("id=")[2]:split("&")[1])
                local targetItem = Arena.Important.ItemName.SurfaceGui.TextLabel.Text
                if isfile(filePath) then local success, result = pcall(function() return (readfile(filePath):match("^" .. escapePattern(targetItem) .. ": %$([%d,]+)") or ""):gsub(",", "") end) Final = success and result or "" end if not Final or Final == "" then local HttpService = game:GetService("HttpService") Final = (function() local data = HttpService:JSONDecode(game:HttpGet("https://economy.roblox.com/v1/assets/"..Second.."/resale-data")) local total, count = 0, 0 for _, v in pairs(data.priceDataPoints or {}) do if v.date:sub(1,7) == "2023-12" then total, count = total + v.value, count + 1 end end return count > 0 and (total / count) or data.recentAveragePrice end)() end
                if tonumber(First) < tonumber(Final) then
                    return true
                else
                    return false
                end
            end
        end
    end
end

function Click(button)
    if not button then return end
    game:GetService("GuiService").SelectedObject = button
    repeat task.wait()
        if game:GetService("GuiService").SelectedObject == button then
            game:GetService("VirtualInputManager"):SendKeyEvent(true, Enum.KeyCode.Return, false, game)
            game:GetService("VirtualInputManager"):SendKeyEvent(false, Enum.KeyCode.Return, false, game)
            task.wait(.1)
        else
            game:GetService("GuiService").SelectedObject = button
        end
    until button.BackgroundTransparency == 1
    task.wait(0.1)
    game:GetService("GuiService").SelectedObject = nil
end

local StartConnection
StartConnection = PriceIsRight.ChildAdded:Connect(function(Choose)
    if Choose.Name == "Bottom Middle Template" then
        if Check_Price() then
            local button = Choose:WaitForChild("Buttons"):WaitForChild("Higher")
            Click(button)
        else
            local button = Choose:WaitForChild("Buttons"):WaitForChild("Lower")
            Click(button)
        end
    end
end)

warn("Price Is Right : Loaded")
